// init.vim のキー割り当てを Vim Like の設定に置き換えたものです。
//
// 使い方: 下の波括弧の「中身」(vimLike.* の3つのキー) をコピーして、お使いの
// settings.json の中に貼り付けてください。いちばん外側の波括弧ごと貼ると、
// 既存の設定を上書きしてしまいます。settings.json にはコメントを書けるので、
// 各行のコメントもそのまま持っていけます。
//
// 対応づけの元にした init.vim の行を、各項目のコメントに添えてあります。
// 置き換えられなかったものはこのファイルの末尾にまとめています。
{
  // let mapleader="\<space>"
  "vimLike.leader": " ",

  // `:` で使える名前を足せます。他の拡張機能のコマンドはここに書きます
  // (この拡張機能の組み込みの表には、同梱していないツールの ID を入れません)。
  // :w などの組み込みの名前は上書きできません。
  "vimLike.exCommands": {
    "gg": ["git-graph.view"]
  },

  "vimLike.normalModeKeyBindings": [
    // ---- 移動キーの置き換え -------------------------------------------------
    // nnoremap H ^
    { "before": ["H"], "after": ["^"] },
    // nnoremap J 10j
    { "before": ["J"], "after": ["1", "0", "j"] },
    // nnoremap K 10k
    { "before": ["K"], "after": ["1", "0", "k"] },
    // nnoremap L $
    { "before": ["L"], "after": ["$"] },
    // nnoremap U <c-r>
    { "before": ["U"], "after": ["<C-r>"] },

    // ---- エディターグループ間の移動 -----------------------------------------
    // nnoremap <leader>h <c-w>h
    { "before": ["<leader>", "h"], "commands": ["workbench.action.navigateLeft"] },
    // nnoremap <leader>j <c-w>j
    { "before": ["<leader>", "j"], "commands": ["workbench.action.navigateDown"] },
    // nnoremap <leader>k <c-w>k
    { "before": ["<leader>", "k"], "commands": ["workbench.action.navigateUp"] },
    // nnoremap <leader>l <c-w>l
    { "before": ["<leader>", "l"], "commands": ["workbench.action.navigateRight"] },

    // ---- タブの移動と作成 ---------------------------------------------------
    // nnoremap <leader>y gT
    { "before": ["<leader>", "y"], "commands": ["workbench.action.previousEditor"] },
    // nnoremap <leader>o gt
    { "before": ["<leader>", "o"], "commands": ["workbench.action.nextEditor"] },
    // nnoremap <leader>i :tabnew<enter>
    { "before": ["<leader>", "i"], "commands": ["workbench.action.files.newUntitledFile"] },

    // ---- 分割とリサイズ -----------------------------------------------------
    // nnoremap <leader>J :vs<enter>   (縦に分割 = 左右に並べる)
    { "before": ["<leader>", "J"], "commands": ["workbench.action.splitEditor"] },
    // nnoremap <leader>L :sp<enter>   (横に分割 = 上下に並べる)
    { "before": ["<leader>", "L"], "commands": ["workbench.action.splitEditorDown"] },
    // nnoremap <leader>wh <c-w><
    { "before": ["<leader>", "w", "h"], "commands": ["workbench.action.decreaseViewWidth"] },
    // nnoremap <leader>wj <c-w>-
    { "before": ["<leader>", "w", "j"], "commands": ["workbench.action.decreaseViewHeight"] },
    // nnoremap <leader>wk <c-w>+
    { "before": ["<leader>", "w", "k"], "commands": ["workbench.action.increaseViewHeight"] },
    // nnoremap <leader>wl <c-w>>
    { "before": ["<leader>", "w", "l"], "commands": ["workbench.action.increaseViewWidth"] },
    // nnoremap <leader>ww <c-w>=
    { "before": ["<leader>", "w", "w"], "commands": ["workbench.action.evenEditorWidths"] },

    // ---- ファイル操作と各種トグル -------------------------------------------
    // nnoremap <leader>s :w<enter>
    { "before": ["<leader>", "s"], "commands": ["workbench.action.files.save"] },
    // nnoremap <leader>n :NvimTreeToggle<enter>
    // サイドバーにエクスプローラーを開いてから、ファイルツリーへフォーカスを
    // 移します。閉じている状態からでも1打鍵でツリーに入れます。
    //
    // これは行き (エディター → ファイルツリー) だけです。ツリー側で同じ打鍵を
    // 使って閉じるには、examples/keybindings.jsonc の "space n" も入れてください。
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.view.explorer", "workbench.files.action.focusFilesExplorer"]
    },
    // nnoremap <leader>t :Term<enter>
    // ターミナルそのものではなく、ターミナル用の作業バッファを開きます。
    // 出力がここに追記され、書いた行を <leader>r で送れます。文書なので
    // Vim のモーション・検索・マークがそのまま効きます。
    // ターミナルの表示切替そのものが欲しい場合は Ctrl+` (VS Code 既定) です。
    { "before": ["<leader>", "t"], "commands": ["vimLike.openTerminalOutput"] },
    { "before": ["<leader>", "r"], "commands": ["vimLike.sendToTerminal"] },
    // nnoremap <leader>z zi
    { "before": ["<leader>", "z"], "commands": ["editor.toggleFold"] },
    // map <leader>/ gc  (キーは <leader>c に移しました。下の「検索」を参照)
    { "before": ["<leader>", "c"], "commands": ["editor.action.commentLine"] },

    // ---- 検索 ---------------------------------------------------------------
    // `/` と `?` はこの拡張機能の検索です (`d/foo` のようにオペレータと
    // 組み合わせられるのはこちらだけ)。VS Code の検索バーは履歴・正規表現の
    // 切り替え・一致件数が使えるので、<leader>/ で開けるようにしています。
    { "before": ["<leader>", "/"], "commands": ["actions.find"] }
  ],

  "vimLike.visualModeKeyBindings": [
    // vnoremap H ^
    { "before": ["H"], "after": ["^"] },
    // vnoremap J 10j
    { "before": ["J"], "after": ["1", "0", "j"] },
    // vnoremap K 10k
    { "before": ["K"], "after": ["1", "0", "k"] },
    // vnoremap L $
    { "before": ["L"], "after": ["$"] },
    // map <leader>/ gc  (map なので Visual モードにも効きます)
    // 選択範囲をまとめてコメントにします。
    { "before": ["<leader>", "c"], "commands": ["editor.action.commentLine"] },
    // 選択した文字列を検索語に入れて検索バーを開きます。actions.find でも既定
    // では同じですが、それは editor.find.seedSearchStringFromSelection 次第です。
    // findWithSelection は設定に関係なく選択範囲を使います。
    { "before": ["<leader>", "/"], "commands": ["actions.findWithSelection"] }
  ]
}

// ============================================================================
// 置き換えなかったもの
// ============================================================================
//
// 設定が不要なもの
//   nnoremap <c-s> :w<enter>
//     Ctrl+S / Cmd+S は VS Code の既定で保存です。Ctrl 系のキーはそもそも
//     `type` コマンドを通らないため、この設定では扱えません。変えたい場合は
//     VS Code のキーボードショートカット設定で行ってください。
//
// 近い動作に置き換えたもの (厳密には別物)
//   nnoremap <leader>n :NvimTreeToggle<enter>
//     workbench.view.explorer はエクスプローラーを開いてフォーカスします。
//     トグルではないので、閉じるには Ctrl+B などを使ってください。
//   nnoremap <leader>z zi
//     VS Code には「折りたたみ機能そのものの有効・無効」という状態がありません。
//     editor.toggleFold はカーソル位置の折りたたみを開閉します。
//   nnoremap <leader>i :tabnew<enter>
//     workbench.action.files.newUntitledFile は空のファイルを開きます。
//     既存ファイルを開きたい場合は workbench.action.quickOpen のほうが近いです。
//
// 別のキーに譲ったもの
//   map <leader>/ gc
//     <leader>/ は VS Code の検索バー (actions.find) に使うことにしたので、
//     コメントのトグルは <leader>c に移しました。VS Code 既定の Cmd+/ も
//     Normal モードからそのまま効きます。
//     `gcip` のようにモーションと組み合わせる形はそもそも入れていません。
//
// 方向移動で足りるので、割り当てないと決めたもの
//   Claude Code や GitHub Copilot Chat のパネルを開くキー
//     Ctrl+W + hjkl の方向移動でどのパネルにも入れるので、AI パネル専用のキーは
//     置いていません。エディターへ戻るキーだけは examples/keybindings.jsonc に
//     あります (Git Graph のようにエディタータブとして開く画面は、方向移動で
//     出られないため)。
//
// 置き換え先がないもの
//   nnoremap <leader>u :-tabnew<enter>    現在のタブの手前に開く相当がありません
//   nnoremap <leader>v :set fileformat=unix<enter>:set list!<enter>
//   nnoremap <leader>x :%!xxd
//   nnoremap <leader>X :%!xxd -r
//     外部コマンドへのパイプと Vim 固有のオプション操作は対象外です。
//     改行コードの変更は VS Code の画面右下の表示から行えます。
