// エディターの外を Vim 風に操作するためのキーバインドです。
//
// これは settings.json ではなく keybindings.json に書きます。
// コマンドパレットで「基本設定: キーボード ショートカットを開く (JSON)」から開けます。
//
// なぜ settings.json ではないのか:
//   エクスプローラーやサイドバーはテキストエディターではないため、この拡張機能の
//   エンジン (モード・オペレータ・モーション) は動きません。打鍵が `type` コマンドを
//   通らないからです。ここでできるのは、VS Code のコマンドを Vim 風のキーに
//   割り当てることだけです。
//
// 引き換えに失うもの:
//   リストで文字を打つとその名前の項目へ飛ぶ「型入力ナビゲーション」が、割り当てた
//   文字については効かなくなります。頻繁に使っている場合は該当する行を削ってください。
[
  // ==========================================================================
  // 1. リストとツリーの移動（エクスプローラー・検索結果・ソース管理など共通）
  // ==========================================================================
  // listFocus はエクスプローラーを含むすべてのリストで真になるので、ここ1か所で
  // 済みます。以前はエクスプローラー用と汎用で同じ内容を二重に持っていました。
  //
  // 入力欄では発火しません。ソース管理ビューを開いた直後はフォーカスがコミット
  // メッセージの入力欄にあるため、そこでは効きません。Tab で一覧へ移ってください。
  { "key": "j", "command": "list.focusDown", "when": "listFocus && !inputFocus" },
  { "key": "k", "command": "list.focusUp", "when": "listFocus && !inputFocus" },
  { "key": "h", "command": "list.collapse", "when": "listFocus && !inputFocus" },
  { "key": "l", "command": "list.expand", "when": "listFocus && !inputFocus" },
  { "key": "g g", "command": "list.focusFirst", "when": "listFocus && !inputFocus" },
  { "key": "shift+g", "command": "list.focusLast", "when": "listFocus && !inputFocus" },
  { "key": "ctrl+d", "command": "list.focusPageDown", "when": "listFocus && !inputFocus" },
  { "key": "ctrl+u", "command": "list.focusPageUp", "when": "listFocus && !inputFocus" },

  // ファイルツリー上で誤って入力する可能性の高いキーを無効化しておく
  { "key": "/", "command": "-list.filter", "when": "listFocus && !inputFocus" },

  // エクスプローラー以外での Enter。エクスプローラーはファイルとフォルダで動作を
  // 分けるため、下で別に定義します。
  { "key": "enter", "command": "list.select", "when": "listFocus && !inputFocus && !filesExplorerFocus" },

  // ==========================================================================
  // 2. エクスプローラー固有のファイル操作
  // ==========================================================================
  { "key": "o", "command": "list.select", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+o", "command": "explorer.openToSide", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "a", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+a", "command": "explorer.newFolder", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "d", "command": "deleteFile", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "y", "command": "filesExplorer.copy", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "p", "command": "filesExplorer.paste", "when": "filesExplorerFocus && !inputFocus" },

  // Enter は対象がファイルかフォルダかで動作を分けます。
  //
  // macOS の Explorer は Enter が既定で「名前の変更」です (Finder に合わせた挙動)。
  // 下の2つで file / folder の両方を覆うため、既定のリネームは発火しなくなります。
  // 名前の変更は r に割り当ててあります。
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && explorerResourceIsFolder && !inputFocus"
  },

  // ==========================================================================
  // 3. エディターへ戻る — ctrl+; ひとつ
  // ==========================================================================
  // Claude Code、エクスプローラー、ソース管理、Git Graph、ターミナル、検索欄。
  // 居場所を問わず、これで編集に戻れます。
  //
  // ただし「戻る」の意味が居場所によって2通りあるので、2行に分かれます。
  // 条件は排他なので、押した場所に応じてどちらか一方だけが動きます。
  //
  // (a) サイドバー・パネル・ターミナル・リストにいる場合。
  //     エディターグループへフォーカスを移せば戻れます。
  //
  //     ターミナルからも効くのは、focusActiveEditorGroup が VS Code の
  //     terminal.integrated.commandsToSkipShell の既定一覧に入っているためです。
  //     一覧にないコマンドはキーごとシェルへ送られます。
  {
    "key": "ctrl+;",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus && !activeWebviewPanelId"
  },

  // (b) Webview が「エディターのタブ」として開いていて、その中にいる場合。
  //     Git Graph が該当します (createWebviewPanel を ViewColumn で開くため)。
  //
  //     この場合 (a) は効きません。その Webview 自身がエディターグループの中に
  //     いるので、「今いるグループにフォーカスする」= 何も起きない、になります。
  //     タブから出る必要があります。
  //
  //     activeWebviewPanelId はエディターグループに紐づくキーとして登録されており、
  //     Webview のタブにフォーカスがあるときだけ立ちます。だから (a) と排他です。
  //
  //     閉じずに戻りたい場合は workbench.action.previousEditor に差し替えて
  //     ください。ただし直前のタブが別の Webview だと、そちらへ移るだけになります。
  {
    "key": "ctrl+;",
    "command": "workbench.action.closeActiveEditor",
    "when": "!editorTextFocus && activeWebviewPanelId"
  },

  // ---- ここから下は上の2行と重なる、別の戻り方です ------------------------
  // ctrl+; ひとつに絞りたい場合は、この3行を削ってください。動作は覆われています。
  // 残す価値があるのは、修飾キーなしで押せる (space l) 点と、閉じてから戻れる
  // (space n) 点です。
  //
  // escape はエクスプローラー内でとっさに戻るための逃げ道です。
  { "key": "escape", "command": "workbench.action.focusActiveEditorGroup", "when": "filesExplorerFocus && !inputFocus" },

  // space l は、エディター内の <leader>l (右のグループへ移動) と同じ打鍵・同じ
  // コマンドです。ツリーが左・エディターが右という配置なら「右へ移る」で通せます。
  { "key": "space l", "command": "workbench.action.navigateRight", "when": "filesExplorerFocus && !inputFocus" },

  // space n はファイルツリーを閉じて戻ります。settings.json の <leader>n と同じ
  // 打鍵で、呼ぶコマンドも同じです。同じコマンドを通すのが大事で、拡張機能は
  // サイドバーが開いているかを VS Code に問い合わせられないため、自分が開閉した
  // 記録を頼りにしています。ここで closeSidebar を直接呼ぶとその記録がずれます。
  { "key": "space n", "command": "vimLike.toggleFileTree", "when": "filesExplorerFocus && !inputFocus" },

  // ==========================================================================
  // 4. 別のウインドウへ移る
  // ==========================================================================
  // VS Code のウインドウを複数開いているときに、選択リストから移ります。
  // 番号で名指しできないのは、拡張機能の API にウインドウを前に出す手段が
  // ないためです (issue #66)。エディターの中からも外からも打てます。
  //
  // macOS では ctrl+0 は既定で「グループ内の最後のタブを開く」
  // (workbench.action.lastEditorInGroup) です。ここで上書きします。
  // Windows / Linux での既定はサイドバーへのフォーカス移動なので、
  // そちらと入れ替わります。
  //
  // ターミナルの中では効きません。switchWindow は VS Code の
  // terminal.integrated.commandsToSkipShell の既定一覧に入っていないため、
  // キーがシェルへ送られます。ターミナルからも飛びたい場合は settings.json に
  // "terminal.integrated.commandsToSkipShell": ["workbench.action.switchWindow"]
  // を足してください。
  { "key": "ctrl+0", "command": "workbench.action.switchWindow" },

  // 選択リストの中の上下です。j / k が使えないのは、絞り込みの入力欄が常に
  // フォーカスを持っていて、文字として入ってしまうためです。既定でも
  // ctrl+n / ctrl+p が同じことをするので、要らなければ削ってください。
  //
  // inQuickOpen が付いているので、効くのは選択リストが出ているあいだだけです。
  // ウインドウの一覧に限らず、コマンドパレットやファイル検索でも同じように動きます。
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" }
]

// ============================================================================
// ターミナルについて
// ============================================================================
//
// VS Code のターミナルに打たれたキーを横取りする API がないため、ターミナル内での
// モーダル編集は提供していません。VSCodeVim も vscode-neovim も同じです。
// (拡張機能が自前で用意する Pseudoterminal なら打鍵を受け取れますが、その場合は
//  シェルの起動から自前になります。採らない判断をした経緯は issue #31 にあります。)
//
// 行編集を Vim 風にしたい場合はシェル側で設定してください。
//
//   bash:  set -o vi              (~/.bashrc)
//   zsh:   bindkey -v             (~/.zshrc)
//
// なお init.vim の tnoremap <Esc> は Neovim 内蔵ターミナルの設定なので、
// VS Code のターミナルには対応するものがありません。
//
// ============================================================================
// 他の環境で使う場合
// ============================================================================
//
// ctrl+; は macOS のシステムショートカットとしては空いています (入力ソース切替が
// 占有している ctrl+space 系を避けて選びました)。
//
// 他の環境へ持っていくときは、VS Code の「キーボード ショートカット」画面で
// そのキーを検索し、既存の割り当てと衝突していないか確かめてください。
